# ── Prophet Arena ───────────────────────────────────────────────
# PA_SERVER_API_KEY is issued by the Prophet Arena operator.
PA_SERVER_URL=https://api.aiprophet.dev
PA_SERVER_API_KEY=
PA_SLUG=everyday-intelli-prophet
PA_N_TICKS=1344

# ── LLM forecaster (any OpenAI-compatible endpoint; OpenRouter default) ──
# OPENROUTER_API_KEY from openrouter.ai. A ":online" model adds web search.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o:online
FORECASTER_BACKEND=auto

# ── Bayesian tempering ──
LLM_WEIGHT=0.7
LLM_TEMPERATURE=1.0
LLM_SAMPLES=1

# ── Trading / risk ──
EV_THRESHOLD=0.05
KELLY_FRACTION=0.25
MAX_TRADES_PER_TICK=20
